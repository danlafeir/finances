# Prisma doesn't auto-load .env — see prisma.config.ts (imports "dotenv/config").
DATABASE_URL="file:./dev.db"
PRICE_TTL_MINUTES=15

# Plaid + encryption key are resolved at launch from 1Password via
# `op run --env-file=.env -- <cmd>` (see package.json's dev/build/start scripts).
# Create a "Finances-Plaid" item (any vault) with fields: client_id, secret,
# encryption_key (secret is the Plaid secret for whatever PLAID_ENV you're on;
# encryption_key is a fresh `openssl rand -base64 32`, decodes to 32 bytes).
PLAID_CLIENT_ID=op://Private/Finances-Plaid/client_id
PLAID_SECRET=op://Private/Finances-Plaid/secret
PLAID_ENV=sandbox
ENCRYPTION_KEY=op://Private/Finances-Plaid/encryption_key
