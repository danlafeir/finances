# Prisma doesn't auto-load .env — see prisma.config.ts (imports "dotenv/config").
DATABASE_URL="file:./dev.db"
PRICE_TTL_MINUTES=15

# Plaid: https://dashboard.plaid.com — client_id and secret are per-environment.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# openssl rand -base64 32 — encrypts PlaidConnection.accessTokenCiphertext at rest.
ENCRYPTION_KEY=
