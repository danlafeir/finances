# Prisma doesn't auto-load .env — see prisma.config.ts (imports "dotenv/config").
DATABASE_URL="file:./dev.db"
PRICE_TTL_MINUTES=15

# Plaid + encryption key (plaintext in .env for now; secret is the Plaid
# secret for whatever PLAID_ENV you're on; encryption_key is a fresh
# `openssl rand -base64 32`, decodes to 32 bytes).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
ENCRYPTION_KEY=
