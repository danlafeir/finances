generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum AccountType {
  CHECKING
  CASH
  CREDIT_CARD
  MORTGAGE
  QUALIFIED_BROKERAGE
  TAXABLE_BROKERAGE
  STOCK_PLAN
  COLLEGE_SAVINGS
  HSA
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  CSV
  PLAID
}

enum TaxFormType {
  FORM_1099_INT
  FORM_1099_DIV_B
  FORM_1098
}

enum VendorTag {
  BILL
  SUBSCRIPTION
  MEMBERSHIP
  INSURANCE
  UTILITY
  OTHER
}

model Account {
  id                  String      @id @default(cuid())
  name                String
  type                AccountType
  broker              String?
  ticker              String?
  isLiability          Boolean     @default(false)
  snapshotBalanceCents Int         @default(0)
  snapshotDate         DateTime?
  interestRateBps      Int?
  contributionCents    Int?
  contributionFrequency String?
  currency             String      @default("USD")
  color               String?
  plaidItemId         String?
  plaidAccountId      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  transactions        Transaction[]
  holdings            Holding[]
  vestingEvents       VestingEvent[]
  mortgageDetails     MortgageDetails?
  taxRecords          TaxRecord[]
}

model MortgageDetails {
  id                  String            @id @default(cuid())
  accountId           String            @unique
  account             Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  homeValueCents      Int
  principalCents      Int
  annualRateBps       Int
  termMonths          Int
  firstPaymentDate    DateTime
  monthlyPaymentCents Int
  payments            MortgagePayment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model MortgagePayment {
  id             String          @id @default(cuid())
  paymentNumber  Int
  paymentDate    DateTime
  paymentCents   Int
  principalCents Int
  interestCents  Int
  balanceCents   Int
  mortgageId     String
  mortgage       MortgageDetails @relation(fields: [mortgageId], references: [id], onDelete: Cascade)

  @@unique([mortgageId, paymentNumber])
  @@index([mortgageId, paymentDate])
}

model VestingEvent {
  id        String   @id @default(cuid())
  date      DateTime
  shares    Float
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([date])
}

model Transaction {
  id             String            @id @default(cuid())
  date           DateTime
  description    String
  amountCents    Int
  type           TransactionType
  source         TransactionSource @default(MANUAL)
  transferPairId String?
  externalId     String?
  notes          String?
  isReconciled   Boolean           @default(false)
  accountId      String
  account        Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([accountId, externalId])
  @@index([date])
  @@index([accountId, date])
  @@index([transferPairId])
}

model Holding {
  id             String   @id @default(cuid())
  ticker         String
  name           String?
  shares         Float
  costBasisCents Int
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([accountId, ticker])
  @@index([ticker])
}

model TaxRecord {
  id        String      @id @default(cuid())
  taxYear   Int
  formType  TaxFormType
  payerName String

  accountId String?
  account   Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  interestIncomeCents           Int? // 1099-INT box 1
  ordinaryDividendsCents        Int? // 1099-DIV box 1a (includes qualified dividends as a subset)
  qualifiedDividendsCents       Int? // 1099-DIV box 1b
  capitalGainDistributionsCents Int? // 1099-DIV box 2a (always long-term by definition)
  shortTermCapitalGainCents     Int? // 1099-B aggregate short-term gain/loss, signed
  longTermCapitalGainCents      Int? // 1099-B aggregate long-term gain/loss, signed
  mortgageInterestPaidCents     Int? // 1098 box 1
  outstandingPrincipalCents     Int? // 1098 box 2
  federalTaxWithheldCents       Int? // 1099-INT box 4 / 1099-DIV box 4

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([taxYear, formType, accountId, payerName])
  @@index([taxYear])
  @@index([accountId])
}

model VendorLabel {
  id          String    @id @default(cuid())
  description String    @unique
  label       String
  tag         VendorTag @default(OTHER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  ticker     String   @unique
  priceCents Int
  currency   String   @default("USD")
  fetchedAt  DateTime @default(now())
  source     String   @default("yahoo-finance2")
}
